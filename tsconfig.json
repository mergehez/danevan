{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "types": ["node", "vite/client"],
        "paths": {
            "@directives": ["./src/directives"],
            "@shared": ["./src/shared"],
            "@shared/*": ["./src/shared/*"],
            "@ui": ["./src/shared/components"],
            "@ui/*": ["./src/shared/components/*"],
            "@utils/*": ["./src/shared/utils/*"],
            "@utils": ["./src/shared/utils"],
            "@datagrid/*": ["./src/datagrid/*"],
            "@datagrid": ["./src/datagrid"],
            "@backend/*": ["./src/backend/*"],
            "@electron": ["./src/electron"],
            "@electron/*": ["./src/electron/*"],
            "@directives/*": ["./src/directives/*"],
            "@lib": ["./src/mainview/lib"],
            "@lib/*": ["./src/mainview/lib/*"],
            "@composables/*": ["./src/mainview/composables/*"],
            "@composables": ["./src/mainview/composables"],
            "@components/*": ["./src/mainview/components/*"],
            "@components": ["./src/mainview/components"]
        }
    },
    "include": ["src", "shims.d.ts", "vite-export-api-methods.ts", "vite.config.ts", "scripts"],
    "exclude": ["node_modules", "dist", "build", "dist-electron"]
}
