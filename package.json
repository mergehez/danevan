{
    "name": "danevan",
    "productName": "Danevan",
    "version": "0.1.0",
    "private": true,
    "description": "Danevan desktop database client with Vue and Vite. Supports MySQL, PostgreSQL, SQLite, SQL Server, and MS Access.",
    "license": "MIT",
    "author": {
        "name": "Mergesoft"
    },
    "config": {
        "appName": "Danevan",
        "appId": "com.mergesoft.danevan",
        "copyright": "Copyright © MergeSoft",
        "vuePort": 3263,
        "apiPort": 3264,
        "dbFileName": "danevan.sqlite"
    },
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "build": "bun install && vite build && bun run build:electron",
        "build:electron": "electron-builder build --config electron.config.js --arm64",
        "dev": "vite",
        "dev2": "vite --mode desktop",
        "test:ui": "vitest run",
        "release:audit": "bun do.ts audit",
        "release:validate": "vitest run --exclude tests/App.real.spec.ts && bun run build",
        "release:mac": "bun do.ts release",
        "release:mac:signed": "bun do.ts release --signed",
        "release:mac:notarize": "bun do.ts release --notarize",
        "lint": "oxfmt && oxlint --fix && vue-tsc --noEmit",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@guolao/vue-monaco-editor": "^1.6.0",
        "better-sqlite3": "^13.0.3",
        "express": "^5.2.1",
        "monaco-editor": "^0.56.0",
        "monaco-sql-languages": "^1.2.0",
        "mssql": "^12.7.0",
        "mysql2": "^3.23.2",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "tailwind-merge": "^3.6.0",
        "typeorm": "^1.1.0",
        "vue": "^3.5.41"
    },
    "devDependencies": {
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/roboto": "^5.3.0",
        "@fontsource/roboto-condensed": "^5.3.0",
        "@iconify/json": "^2.2.510",
        "@iconify/tailwind4": "^1.2.3",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/mssql": "^12.3.0",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^9.2.4",
        "dt-sql-parser": "^4.5.0",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.10",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    },
    "overrides": {
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.15.tsgo.7.0.2"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        }
    }
}
